{
  "_about": "Grip It design tokens. Dark-first (gym-like), single theme for MVP. Role names are fixed; /replica-brand may change values. Check every change with: python3 contrast.py tokens.json",
  "color": {
    "bg": "#0B0B0D",
    "surface": "#16171B",
    "surface-raised": "#202228",
    "border": "#2E3139",
    "border-input": "#70757F",
    "text": "#F4F4F2",
    "text-muted": "#A3A6AE",
    "text-subtle": "#868A93",
    "accent": "#D4FF3A",
    "on-accent": "#0B0B0D",
    "danger": "#FF6369",
    "on-danger": "#0B0B0D",
    "success": "#3DDC97",
    "warning": "#FFC53D",
    "pr": "#FFC53D",
    "on-pr": "#0B0B0D",
    "rank-gold": "#FFC53D",
    "rank-silver": "#C9CDD4",
    "rank-bronze": "#E0915A",
    "focus": "#D4FF3A",
    "scrim": "#000000"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-raised"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-raised"],
    ["text-subtle", "bg"],
    ["text-subtle", "surface"],
    ["on-accent", "accent"],
    ["accent", "bg"],
    ["accent", "surface"],
    ["accent", "surface-raised"],
    ["on-danger", "danger"],
    ["danger", "bg"],
    ["danger", "surface"],
    ["success", "bg"],
    ["success", "surface"],
    ["warning", "surface"],
    ["on-pr", "pr"],
    ["pr", "surface"],
    ["rank-gold", "surface"],
    ["rank-silver", "surface"],
    ["rank-bronze", "surface"],
    ["border-input", "bg", "ui"],
    ["border-input", "surface", "ui"],
    ["border-input", "surface-raised", "ui"],
    ["focus", "bg", "ui"],
    ["focus", "surface", "ui"]
  ],
  "font": {
    "display": "'Barlow Condensed', 'Arial Narrow', system-ui, sans-serif",
    "sans": "Barlow, system-ui, -apple-system, sans-serif",
    "numeric": "'Barlow Condensed', system-ui, sans-serif",
    "_numeric_note": "always with font-variant-numeric: tabular-nums so kg/reps columns don't jitter"
  },
  "type": {
    "xs": {"size": 12, "line": 16, "weight": 500, "family": "sans"},
    "sm": {"size": 14, "line": 20, "weight": 400, "family": "sans"},
    "base": {"size": 16, "line": 24, "weight": 400, "family": "sans"},
    "lg": {"size": 20, "line": 26, "weight": 600, "family": "display"},
    "xl": {"size": 28, "line": 32, "weight": 700, "family": "display"},
    "display": {"size": 40, "line": 44, "weight": 700, "family": "display", "transform": "uppercase"},
    "stat": {"size": 32, "line": 36, "weight": 600, "family": "numeric"},
    "_units": "px at default text size; implemented in rem so iOS text-size settings scale them"
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 48, 64],
  "radius": {"sm": 8, "md": 12, "lg": 20, "pill": 999},
  "shadow": {
    "card": "0 0 0 1px #2E3139",
    "pop": "0 16px 40px rgba(0,0,0,.55)",
    "_note": "dark UI: elevation comes from surface steps + hairline borders, not drop shadows"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "spring": "cubic-bezier(.34,1.56,.64,1)",
    "_note": "spring only for celebratory moments (PR, badge, rank-up); all motion off under prefers-reduced-motion"
  },
  "layout": {
    "max-width": 480,
    "gutter": 16,
    "tab-bar-height": 56,
    "header-height": 52,
    "touch-min": 44,
    "set-row-height": 52,
    "_safe_area": "pad with env(safe-area-inset-*) on header, tab bar and sticky CTA"
  }
}
